{
	"name": "mocha-ctrf-json-reporter",
	"version": "0.2.1",
	"description": "A Mocha test reporter to create test results reports",
	"type": "module",
	"main": "./dist/index.cjs",
	"module": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js",
			"require": "./dist/index.cjs"
		},
		"./runtime": {
			"types": "./dist/runtime.d.ts",
			"import": "./dist/runtime.js",
			"require": "./dist/runtime.cjs"
		}
	},
	"scripts": {
		"build": "tsup && node scripts/write-cjs-shims.mjs",
		"build:check": "tsc -p . --noEmit",
		"build:watch": "tsup --watch",
		"clean": "rm -rf dist && rm -rf coverage && rm -rf ctrf",
		"test": "npm run build && mocha --reporter ./dist/index.cjs ./tests",
		"lint": "biome lint --write . --unsafe",
		"lint:check": "biome lint .",
		"format": "biome format --write .",
		"format:check": "biome format .",
		"all": "npm run build:check && npm run lint:check && npm run format:check && npm run test && npm run build",
		"check": "biome check .",
		"test:standard:checker": "node tests/standard/checker/run.mjs",
		"test:standard:conformance:unit": "npm run build && node tests/standard/conformance/run.mjs unit",
		"test:standard:conformance:integration": "npm run build && node tests/standard/conformance/run.mjs integration",
		"test:standard:conformance": "node tests/standard/conformance/run-all.mjs",
		"test:standard": "node tests/standard/run-all.mjs"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/ctrf-io/mocha-ctrf-json-reporter.git"
	},
	"publishConfig": {
		"access": "public",
		"provenance": true
	},
	"homepage": "https://ctrf.io",
	"files": [
		"dist/",
		"README.md"
	],
	"author": "Matthew Poulton-White",
	"license": "MIT",
	"keywords": [
		"ctrf",
		"common-test-report-format",
		"test-reporting",
		"test-results",
		"testing",
		"json",
		"ci",
		"mocha",
		"mocha-reporter"
	],
	"security": {
		"email": "security@ctrf.io",
		"url": "https://github.com/ctrf-io/.github/blob/main/SECURITY.md"
	},
	"devDependencies": {
		"@biomejs/biome": "2.6.3",
		"@types/md5": "2.3.6",
		"@types/mocha": "10.0.10",
		"@types/node": "26.6.5",
		"mocha": "12.0.3",
		"tsup": "9.0.0",
		"typescript": "npm:@typescript/typescript6@6.0.2",
		"@typescript/native": "npm:typescript@7.0.2",
		"ajv": "8.20.0",
		"ajv-formats": "3.0.1"
	},
	"dependencies": {
		"ctrf": "0.5.0",
		"md5": "2.3.0"
	},
	"overrides": {
		"serialize-javascript": "7.1.4",
		"esbuild": "0.28.2"
	}
}
